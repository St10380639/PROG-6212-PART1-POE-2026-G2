FROM ://microsoft.com AS base
WORKDIR /app
EXPOSE 8080
EXPOSE 8081

FROM ://microsoft.com AS build
WORKDIR /src
COPY ["Race Day Part 3.csproj", "."]
RUN dotnet restore "./Race Day Part 3.csproj"
COPY . .
WORKDIR "/src/."
RUN dotnet build "Race Day Part 3.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "Race Day Part 3.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "Race Day Part 3.dll"]