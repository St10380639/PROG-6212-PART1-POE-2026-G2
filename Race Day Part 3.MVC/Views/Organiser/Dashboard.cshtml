@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div style="padding: 20px; max-width: 1000px; margin: 0 auto;">
    <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); margin-bottom: 30px;">
        <h1 style="color: #333; margin: 0; font-weight: 800;">🏆 Organiser Control Panel</h1>
        <p style="color: #666; margin-top: 5px;">Welcome back to your administration command console portal.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 40px;">
        <div style="background: #ff5722; color: white; padding: 25px; border-radius: 10px; text-align: center; font-weight: bold; box-shadow: 0 4px 10px rgba(255,87,34,0.3);">
            <div style="font-size: 14px; text-transform: uppercase; opacity: 0.9;">Total Managed Events</div>
            <div style="font-size: 36px; margin-top: 5px; font-weight: 900;">12</div>
        </div>
        <div style="background: #2196f3; color: white; padding: 25px; border-radius: 10px; text-align: center; font-weight: bold; box-shadow: 0 4px 10px rgba(33,150,243,0.3);">
            <div style="font-size: 14px; text-transform: uppercase; opacity: 0.9;">Active Enrolments</div>
            <div style="font-size: 36px; margin-top: 5px; font-weight: 900;">458</div>
        </div>
        <div style="background: #4caf50; color: white; padding: 25px; border-radius: 10px; text-align: center; font-weight: bold; box-shadow: 0 4px 10px rgba(76,175,80,0.3);">
            <div style="font-size: 14px; text-transform: uppercase; opacity: 0.9;">Published Results</div>
            <div style="font-size: 36px; margin-top: 5px; font-weight: 900;">84</div>
        </div>
    </div>
</div>
