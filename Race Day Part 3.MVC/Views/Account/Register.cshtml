@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-5">
        <div class="card p-4">
            <div class="text-center mb-4">
                <h2 class="font-weight-bold" style="margin: 0; color: #333;">Create Profile</h2>
                <p class="text-muted">Join the RaceDay network</p>
            </div>

            <form asp-controller="Account" asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label class="font-weight-bold">Full Name</label>
                    <input type="text" name="name" class="form-control" required placeholder="John Doe" />
                </div>

                <div class="form-group">
                    <label class="font-weight-bold">Email Address</label>
                    <input type="email" name="email" class="form-control" required placeholder="john.doe@example.com" />
                </div>

                <div class="form-group">
                    <label class="font-weight-bold">Password</label>
                    <input type="password" name="password" class="form-control" required placeholder="Create secure password" />
                </div>

                <div class="form-group" style="margin-bottom: 25px;">
                    <label class="font-weight-bold">System Role Membership</label>
                    <select name="role" class="form-control" required style="height: 48px;">
                        <option value="Participant">Participant (View & Enrol in Events)</option>
                        <option value="Organiser">Organiser (Create & Manage Events)</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-sporty btn-block btn-lg shadow-sm">Submit Registration</button>
            </form>

            <div class="text-center" style="margin-top: 25px;">
                <p class="mb-0 text-muted" style="font-size: 15px;">Already registered? <a asp-controller="Account" asp-action="Login" style="color: #ff5722; font-weight: bold; text-decoration: none;">Sign In here</a></p>
            </div>
        </div>
    </div>
</div>
